# Build dos frontends (NEXT_PUBLIC_* é fixado NO BUILD).
# Na VM: copie para .env.local e troque SEU-DOMINIO.com pelo seu domínio.
#   cp apps/web-store/.env.local.example apps/web-store/.env.local
NEXT_PUBLIC_API_URL=https://api.SEU-DOMINIO.com
NEXT_PUBLIC_WS_URL=wss://api.SEU-DOMINIO.com
NEXT_PUBLIC_STORE_URL=https://loja.SEU-DOMINIO.com
