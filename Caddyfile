# Caddy — proxy reverso + HTTPS automático (Let's Encrypt).
# >>> TROQUE "SEU-DOMINIO.com" pelo seu domínio em TODAS as linhas abaixo. <<<
# Cada subdomínio precisa de um registro DNS tipo A apontando para o IP da VM.
#
# E-mail para avisos do Let's Encrypt (opcional, recomendado):
{
	email seu-email@exemplo.com
}

# API (Fastify) — WebSocket do socket.io funciona automaticamente.
api.SEU-DOMINIO.com {
	reverse_proxy api:3333
}

# Painel do lojista
admin.SEU-DOMINIO.com {
	reverse_proxy web-admin:3000
}

# Vitrine (clientes)
loja.SEU-DOMINIO.com {
	reverse_proxy web-store:3001
}

# Super-admin (opcional)
painel.SEU-DOMINIO.com {
	reverse_proxy web-superadmin:3002
}

# Evolution / WhatsApp — opcional expor publicamente (API e Evolution já
# conversam pela rede interna). Útil só para depurar. Descomente se precisar:
# whatsapp.SEU-DOMINIO.com {
# 	reverse_proxy evolution-api:8080
# }
