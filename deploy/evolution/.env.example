# ─────────────────────────────────────────
# Evolution API — configuração de produção (VPS)
# Copie para .env e troque TODOS os valores marcados com CHANGE_ME.
# ─────────────────────────────────────────

# Domínio público da Evolution (registro A apontando para o IP do VPS).
# Usado pelo Caddy (profile "proxy") para emitir o certificado HTTPS.
EVOLUTION_DOMAIN=whatsapp.SEU-DOMINIO.com

# URL pública por onde a Evolution é acessada (HTTPS via Caddy).
# Deve ser https://<EVOLUTION_DOMAIN>. Usada na geração de QRCode/links.
SERVER_URL=https://whatsapp.SEU-DOMINIO.com

# Porta interna publicada no host (só localhost). Em produção pode deixar o padrão.
EVOLUTION_PORT=8080

# Chave GLOBAL da plataforma. A API do delivery usa esta mesma chave para
# provisionar instâncias (EVOLUTION_API_KEY no .env da API).
AUTHENTICATION_API_KEY=CHANGE_ME_chave_forte_aleatoria
AUTHENTICATION_TYPE=apikey

# ── Banco (Postgres dedicado da Evolution) ──
# Mantenha POSTGRES_* em sincronia com a DATABASE_CONNECTION_URI abaixo.
POSTGRES_USER=evolution
POSTGRES_PASSWORD=CHANGE_ME_senha_forte
POSTGRES_DB=evolution

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
# IMPORTANTE: docker env_file NÃO interpola ${VAR}; escreva a URI literal,
# repetindo usuário/senha/db exatamente como acima.
DATABASE_CONNECTION_URI=postgresql://evolution:CHANGE_ME_senha_forte@evolution-postgres:5432/evolution?schema=public
DATABASE_CONNECTION_CLIENT_NAME=evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# ── Cache (Redis dedicado) ──
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/0
CACHE_REDIS_PREFIX_KEY=evolution
CACHE_REDIS_SAVE_INSTANCES=true
CACHE_LOCAL_ENABLED=false

# ── Diversos ──
QRCODE_LIMIT=30
DEL_INSTANCE=false
LOG_LEVEL=ERROR
