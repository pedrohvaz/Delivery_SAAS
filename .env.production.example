# ╔══════════════════════════════════════════════════════════════════╗
# ║  PRODUÇÃO (VM Oracle) — copie para .env e preencha.                ║
# ║  docker compose -f docker-compose.server.yml up -d --build         ║
# ╚══════════════════════════════════════════════════════════════════╝
#
# Trocar "SEU-DOMINIO.com" pelo seu domínio. Itens "(REUSAR DO RAILWAY)"
# devem ser copiados do painel de Variables do Railway (mesmos valores).
#
# OBS: DATABASE_URL, REDIS_URL, EVOLUTION_API_URL e API_PUBLIC_URL são
# definidos AUTOMATICAMENTE pelo docker-compose.server.yml — NÃO precisa setar.

# ── Senhas de banco (você inventa; fortes) ─────────────────────────
POSTGRES_PASSWORD=troque_por_senha_forte_do_postgres
EVOLUTION_PG_PASSWORD=troque_por_senha_forte_do_evolution_pg

# ── API ────────────────────────────────────────────────────────────
PORT=3333
HOST=0.0.0.0
NODE_ENV=production
JWT_SECRET=COLE_O_MESMO_JWT_SECRET_DO_RAILWAY   # (REUSAR DO RAILWAY — senão sessões quebram)
JWT_EXPIRES_IN=7d
# Origens permitidas (as URLs https dos frontends):
CORS_ORIGIN=https://admin.SEU-DOMINIO.com,https://loja.SEU-DOMINIO.com,https://painel.SEU-DOMINIO.com
# Base pública da vitrine (link do cardápio enviado pelo bot):
STORE_URL=https://loja.SEU-DOMINIO.com
# URL pública da API — usada para servir as fotos enviadas (/uploads) quando não há R2.
UPLOADS_PUBLIC_URL=https://api.SEU-DOMINIO.com

# ── WhatsApp / Evolution ───────────────────────────────────────────
# Chave global (use a mesma no serviço evolution-api do compose). Gere uma forte.
EVOLUTION_API_KEY=troque_por_chave_forte_aleatoria
# URL que o Evolution usa em links internos (pode deixar a interna):
EVOLUTION_SERVER_URL=http://evolution-api:8080

# ── IA da plataforma (fallback quando a loja não tem chave própria) ─
OPENROUTER_API_KEY=   # (REUSAR DO RAILWAY, se houver)
OPENAI_API_KEY=       # (REUSAR DO RAILWAY, se houver)
ANTHROPIC_API_KEY=    # (REUSAR DO RAILWAY, se houver)

# ── Pagamentos / Storage / Outros (REUSAR DO RAILWAY) ──────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=production
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Microsserviço de cardápio em imagem (opcional; não sobe nesta stack) ─
PYTHON_SERVICE_URL=

# ── Limites do bot (defaults sensatos) ─────────────────────────────
BOT_MAX_QTD_ITEM=50
BOT_MAX_ITENS=40
BOT_MAX_VALOR_PEDIDO=1500
BOT_MAX_MSG_CHARS=1000
BOT_RATE_MAX=20
BOT_RATE_WINDOW_MS=300000
BOT_DEDUPE_MS=3000
BOT_DUP_ORDER_MIN=5
