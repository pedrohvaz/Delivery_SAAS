# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────
DATABASE_URL="postgresql://delivery:delivery123@localhost:5433/delivery_dev"

# ─────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────
# API
# ─────────────────────────────────────────
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET="troque-por-uma-string-segura-em-producao"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# ─────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3333"
NEXT_PUBLIC_WS_URL="ws://localhost:3333"
NEXT_PUBLIC_STORE_URL="http://localhost:3001"

# ─────────────────────────────────────────
# STORAGE (Cloudflare R2)
# ─────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# ─────────────────────────────────────────
# PAGAMENTOS (Asaas)
# ─────────────────────────────────────────
ASAAS_API_KEY=""
ASAAS_ENVIRONMENT="sandbox"  # sandbox | production

# ─────────────────────────────────────────
# STRIPE (Assinaturas dos lojistas)
# ─────────────────────────────────────────
# Chave secreta — pega em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Segredo do webhook — pega em https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=""

# ─────────────────────────────────────────
# WHATSAPP (Evolution API)
# ─────────────────────────────────────────
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""

# ─────────────────────────────────────────
# FIREBASE (Push Notifications)
# ─────────────────────────────────────────
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ─────────────────────────────────────────
# CARDÁPIO EM IMAGEM (microsserviço Python)
# ─────────────────────────────────────────
PYTHON_SERVICE_URL="http://localhost:8001"

# ─────────────────────────────────────────
# IA — chaves da PLATAFORMA (fallback do bot de atendimento)
# Cada loja pode usar a própria chave (BYO) em AutomationConfig.aiApiKey;
# se não tiver, o bot cai para estas chaves de ambiente conforme o provedor.
# OPENAI_API_KEY também é usada pelo microsserviço de cardápio (DALL-E/GPT).
# OPENROUTER_API_KEY dá acesso a vários modelos via uma única conta.
# ─────────────────────────────────────────
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# ─────────────────────────────────────────
# WHATSAPP / EVOLUTION (provisionamento automático por loja)
# Servidor Evolution da plataforma (ver deploy/evolution). A API cria uma
# instância por loja e registra o webhook automaticamente.
# ─────────────────────────────────────────
EVOLUTION_API_URL=""        # ex.: https://whatsapp.bylink.shop
EVOLUTION_API_KEY=""        # = AUTHENTICATION_API_KEY do servidor Evolution
# URL pública desta API (alvo dos webhooks do WhatsApp).
# Local (Evolution em Docker): http://host.docker.internal:3333
# Produção: https://api.bylink.shop
API_PUBLIC_URL="http://host.docker.internal:3333"
# Base pública da vitrine (link do cardápio enviado pelo bot).
STORE_URL="http://localhost:3001"

# ─────────────────────────────────────────
# LIMITES / SEGURANÇA DO BOT (defaults sensatos; ajuste se precisar)
# ─────────────────────────────────────────
BOT_MAX_QTD_ITEM="50"          # quantidade máxima por item
BOT_MAX_ITENS="40"             # itens distintos no carrinho
BOT_MAX_VALOR_PEDIDO="1500"    # teto de valor (R$) para finalizar sozinho
BOT_MAX_MSG_CHARS="1000"       # tamanho máx. da mensagem do cliente
BOT_RATE_MAX="20"              # msgs por janela, por cliente
BOT_RATE_WINDOW_MS="300000"    # janela do rate-limit (5 min)
BOT_DEDUPE_MS="3000"           # ignora msg idêntica repetida nesse intervalo
BOT_DUP_ORDER_MIN="5"          # janela (min) para detectar pedido duplicado
